---
import Layout from '@/layouts/Layout.astro';
import Container from '@/components/Container.astro';
import Sectionhead from '@/components/Sectionhead.astro';
import PostCard from '@/components/PostCard.astro';
import { getPublishedPosts, tagSlug } from '@/utils/posts';

const posts = await getPublishedPosts();
const [featured, ...rest] = posts;
// Only tags shared by two or more posts, so one-off Medium tags don't crowd the header.
const tagCounts = new Map<string, number>();
posts.flatMap((p) => p.data.tags).forEach((t) => tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1));
const tags = [...tagCounts].filter(([, n]) => n > 1).map(([t]) => t).sort();
---

<Layout>
	<Container>
		<Sectionhead>
			<Fragment slot="title">The agriengg.tech blog</Fragment>
			<Fragment slot="desc">Notes on agricultural engineering, precision farming and the tech we build.</Fragment>
		</Sectionhead>

		{
			tags.length > 0 && (
				<div class="flex flex-wrap justify-center gap-2 mt-8">
					{tags.map((tag) => (
						<a href={`/tags/${tagSlug(tag)}/`} class="text-sm px-3 py-1 rounded-full bg-sage-wash text-sage-dark hover:bg-sage-pale transition">
							#{tag}
						</a>
					))}
				</div>
			)
		}

		<main class="mt-16">
			{posts.length === 0 && <p class="text-center text-slate-500">No posts yet.</p>}
			{featured && <PostCard post={featured} featured />}
			{
				rest.length > 0 && (
					<ul class="grid gap-16 md:grid-cols-2 lg:grid-cols-3 mt-16">
						{rest.map((post) => (
							<li>
								<PostCard post={post} />
							</li>
						))}
					</ul>
				)
			}
		</main>
	</Container>
</Layout>
