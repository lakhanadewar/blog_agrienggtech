---
import Layout from '@/layouts/Layout.astro';
import Container from '@/components/Container.astro';
import Sectionhead from '@/components/Sectionhead.astro';
---

<Layout title="Page not found">
	<Container>
		<Sectionhead>
			<Fragment slot="title">Page not found</Fragment>
			<Fragment slot="desc">That article may have moved. Try the <a href="/" class="text-sage underline">blog home</a>.</Fragment>
		</Sectionhead>
	</Container>
</Layout>
