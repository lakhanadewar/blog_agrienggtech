---
import Layout from '@/layouts/Layout.astro';
import Container from '@/components/Container.astro';
import Sectionhead from '@/components/Sectionhead.astro';
import PostCard from '@/components/PostCard.astro';
import { getPublishedPosts, tagSlug } from '@/utils/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	const tags = new Map<string, string>();
	posts.forEach((p) => p.data.tags.forEach((t) => tags.set(tagSlug(t), t)));
	return [...tags].map(([slug, name]) => ({
		params: { tag: slug },
		props: { name, posts: posts.filter((p) => p.data.tags.some((t) => tagSlug(t) === slug)) },
	}));
}

const { name, posts } = Astro.props;
---

<Layout title={`#${name}`} description={`Posts tagged ${name} on the agriengg.tech blog.`}>
	<Container>
		<Sectionhead>
			<Fragment slot="title">#{name}</Fragment>
			<Fragment slot="desc">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</Fragment>
		</Sectionhead>
		<ul class="grid gap-16 md:grid-cols-2 lg:grid-cols-3 mt-16">
			{posts.map((post) => <li><PostCard post={post} /></li>)}
		</ul>
		<div class="text-center mt-12">
			<a href="/" class="bg-gray-100 px-5 py-3 rounded-md hover:bg-gray-200 transition">← All posts</a>
		</div>
	</Container>
</Layout>
